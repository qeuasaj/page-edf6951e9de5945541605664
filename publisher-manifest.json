er;gap: 0.75rem}\n\nh3.plan-name {font-size: 1.4rem;font-weight: 700;color: var(--brown-900)}\n\n.plan-tag {font-size: 0.75rem;background: var(--mint-100);color: var(--mint-600);padding: 0.2rem 0.6rem;border-radius: 2px;font-weight: 600}\n\n.plan-price-wrap {text-align: right}\n\n.plan-price {font-size: 1.8rem;font-weight: 800;color: var(--brown-900)}\n\n.plan-annual {font-size: 0.85rem;color: var(--mint-600);font-weight: 500}\n\n.plan-question-prompt {font-size: 0.92rem;color: var(--brown-600);font-style: italic;margin-bottom: 1.5rem;position: relative;z-index: 1}\n\n.plan-features-list {display: grid;grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));gap: 0.75rem 1.5rem;list-style: none;padding-top: 1.25rem;border-top: 1px solid var(--brown-100);position: relative;z-index: 1}\n\n.plan-features-list li {font-size: 0.95rem;color: var(--brown-800);display: flex;align-items: center;gap: 0.5rem}\n\n.plan-features-list li::before {content: \"\";display: inline-block;width: 6px;height: 6px;background-color: var(--mint-500);border-radius: 50%}\n\n.steps-section {margin-bottom: 5rem}\n\n.steps-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));gap: 1.5rem}\n\n.step-card {position: relative;background: var(--white);border: 1px solid var(--brown-100);padding: 2.25rem;overflow: hidden;border-radius: 4px}\n\n.step-card-number {position: absolute;right: 1rem;bottom: -0.5rem;font-size: 6rem;font-weight: 900;line-height: 1;color: rgba(36, 29, 26, 0.04);pointer-events: none;user-select: none}\n\n.step-card h3 {font-size: 1.15rem;margin-bottom: 0.75rem;color: var(--brown-900);position: relative;z-index: 1}\n\n.step-card p {font-size: 0.9rem;color: var(--brown-600);position: relative;z-index: 1}\n\n.clients-section {background: var(--white);border: 1px solid var(--brown-100);padding: 2.5rem;border-radius: 4px;margin-bottom: 5rem}\n\n.clients-content {display: grid;grid-template-columns: 1fr 1fr;gap: 2.5rem;margin-top: 1.5rem}\n\n.clients-content p {font-size: 0.95rem;color: var(--brown-800)}\n\n.faq-section {margin-bottom: 5rem}\n\n.faq-stack {display: flex;flex-direction: column;gap: 1rem}\n\ndetails {background: var(--white);border: 1px solid var(--brown-100);border-radius: 4px;padding: 1.25rem 1.75rem}\n\ndetails[open] {border-color: var(--mint-300);background: var(--mint-50)}\n\nsummary {font-size: 1.05rem;font-weight: 600;color: var(--brown-900);cursor: pointer;list-style: none;display: flex;justify-content: space-between;align-items: center}\n\nsummary::-webkit-details-marker {display: none}\n\nsummary::after {content: \"+\";font-size: 1.4rem;font-weight: 300;color: var(--mint-600);transition: transform 0.2s ease}\n\ndetails[open] summary::after {content: \"−\"}\n\n.faq-answer {padding-top: 1rem;margin-top: 0.75rem;border-top: 1px solid rgba(36, 29, 26, 0.08);font-size: 0.95rem;color: var(--brown-600)}\n\nfooter {border-top: 1px solid var(--brown-100);padding: 2.5rem 1.5rem;text-align: center;font-size: 0.85rem;color: var(--brown-600);background: var(--white)}\n\n@media (max-width: 860px) {\n  .hero-layout {grid-template-columns: 1fr;min-height: auto}\n  .hero-column {padding: 3rem 0;border-right: none;border-bottom: 1px solid var(--brown-100)}\n  .hero-space {padding: 2.5rem 0}\n  .clients-content {grid-template-columns: 1fr;gap: 1.5rem}\n  .plan-card {padding: 2rem 1.5rem}\n}\n</style><header>\n  <div class=\"nav-container\">\n    <div class=\"breadcrumb\">\n      <span>服务导航</span> / <span>熊云概览</span> / <span>配置清单</span>\n    </div>\n    <ul class=\"table-of-contents\">\n      <li><a href=\"#hero\">关于我们</a></li>\n      <li><a href=\"#plans\">订阅规格</a></li>\n      <li><a href=\"#steps\">接入指南</a></li>\n      <li><a href=\"#clients\">终端说明</a></li>\n      <li><a href=\"#faq\">答疑中心</a></li>\n    </ul>\n  </div>\n</header>\n\n<main>\n  <section class=\"hero-layout\" id=\"hero\">\n    <div class=\"hero-column\">\n      <span class=\"hero-tag\">专线架构与订阅集成</span>\n      <h1>熊云</h1>\n      <p class=\"hero-lead\">\n        你是否在找寻一种安静、有序且兼顾多端协同的接入体验？熊云在此呈现标准化的数据配置与清晰的服务规划。\n      </p>\n      <div class=\"hero-question\">\n        <strong>如何判定是否适用？</strong><br>\n        如果你重视多设备容纳能力、稳定的流量分配以及明晰的工单反馈，这里的规则已全部陈列在册。\n      </div>\n    </div>\n    <div class=\"hero-space\">\n      <div class=\"hero-abstract-stamp\">\n        档案编号：XY-2024 / 状态：现行\n      </div>\n      <div class=\"hero-quiet-panel\">\n        <div class=\"hero-quiet-title\">设计准则</div>\n        <div class=\"hero-quiet-desc\">\n          去除多余的界面修饰，以简明的规格对照与问答引导，使每个网络分流决策都有据可循。\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans-section\" id=\"plans\">\n    <div class=\"section-head\">\n      <span class=\"section-caption\">PLANS AND TIERS</span>\n      <h2>怎样选择适合自己的规格档位？</h2>\n      <p class=\"section-guide-text\">依据日常吞吐规模与同时在线的终端数量，逐级查看对应的服务范围。</p>\n    </div>\n\n    <div class=\"plans-stack\">\n      <article class=\"plan-card\">\n        <div class=\"plan-card-bg-number\">01</div>\n        <div class=\"plan-header-row\">\n          <div class=\"plan-title-wrap\">\n            <h3 class=\"plan-name\">基础版</h3>\n            <span class=\"plan-tag\">个人轻量</span>\n          </div>\n          <div class=\"plan-price-wrap\">\n            <div class=\"plan-price\">¥15<small>/月</small></div>\n            <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n          </div>\n        </div>\n        <p class=\"plan-question-prompt\">需要单人日常浏览与轻度影音，且常驻设备不超过三台？</p>\n        <ul class=\"plan-features-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-card featured\">\n        <div class=\"plan-card-bg-number\">02</div>\n        <div class=\"plan-header-row\">\n          <div class=\"plan-title-wrap\">\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <span class=\"plan-tag\">推荐配置</span>\n          </div>\n          <div class=\"plan-price-wrap\">\n            <div class=\"plan-price\">¥35<small>/月</small></div>\n            <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n          </div>\n        </div>\n        <p class=\"plan-question-prompt\">追求低延迟链路、深度流媒体兼容并兼顾家庭或多机位？</p>\n        <ul class=\"plan-features-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-card\">\n        <div class=\"plan-card-bg-number\">03</div>\n        <div class=\"plan-header-row\">\n          <div class=\"plan-title-wrap\">\n            <h3 class=\"plan-name\">团队版</h3>\n            <span class=\"plan-tag\">多协作者</span>\n          </div>\n          <div class=\"plan-price-wrap\">\n            <div class=\"plan-price\">¥85<small>/月</small></div>\n            <div class=\"plan-annual\">按年付仅需 ¥850/年</div>\n          </div>\n        </div>\n        <p class=\"plan-question-prompt\">面向工作室、多成员协作以及需要专属带宽通道的场景？</p>\n        <ul class=\"plan-features-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"steps-section\" id=\"steps\">\n    <div class=\"section-head\">\n      <span class=\"section-caption\">DEPLOYMENT FLOW</span>\n      <h2>接入网络需要经历哪些环节？</h2>\n      <p class=\"section-guide-text\">遵循标准订阅流程，从配置获取到分流就绪只需四步推进。</p>\n    </div>\n\n    <div class=\"steps-grid\">\n      <div class=\"step-card\">\n        <div class=\"step-card-number\">01</div>\n        <h3>确认匹配套餐</h3>\n        <p>在控制面板中核查当前订阅状态，确认流量配额与同时在线设备数是否与当前网络需求一致。</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-card-number\">02</div>\n        <h3>获取订阅凭据</h3>\n        <p>在用户中心复制对应的专属订阅链接，注意妥善保管该配置凭据，避免泄露给无关人员。</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-card-number\">03</div>\n        <h3>导入配置文件</h3>\n        <p>将订阅链接粘贴至所用客户端的订阅管理或配置源中，执行更新并确认节点列表完整拉取。</p>\n      </div>\n\n      <div class=\"step-card\">\n        <div class=\"step-card-number\">04</div>\n        <h3>选择分流规则</h3>\n        <p>依据网络需求选取对应地区或规则集（如按规则分流或全局路由），启动连接并完成连通性测试。</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"clients-section\" id=\"clients\">\n    <div class=\"section-head\">\n      <span class=\"section-caption\">COMPATIBILITY &amp; CLIENTS</span>\n      <h2>客户端适配与使用规范</h2>\n    </div>\n    <div class=\"clients-content\">\n      <div>\n        <h3>关于客户端软件的来源</h3>\n        <p>\n          熊云提供通用的标准协议订阅链接，不捆绑专有客户端。用户可选用业内通行的通用开源内核工具或兼容订阅协议的客户端应用程序。\n        </p>\n      </div>\n      <div>\n        <h3>多平台部署建议</h3>\n        <p>\n          支持在 Windows、macOS、Linux、iOS 及 Android 等多种操作系统上运行通用客户端。因各客户端更新周期各异，请以对应开发者发布的稳定版本为准。\n        </p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"faq-section\" id=\"faq\">\n    <div class=\"section-head\">\n      <span class=\"section-caption\">FREQUENTLY ASKED QUESTIONS</span>\n      <h2>还有哪些疑问需要在此理清？</h2>\n      <p class=\"section-guide-text\">点击下列各项展开对应问答说明。</p>\n    </div>\n\n    <div class=\"faq-stack\">\n      <details>\n        <summary>订阅中的设备数量限制是如何计量的？</summary>\n        <div class=\"faq-answer\">\n          设备限制以同时发起网络请求的在线客户端 IP 或接入识别为准。若超出该档位允许的最大并发数，后连接的设备可能出现请求阻塞或节点同步失败。\n        </div>\n      </details>\n\n      <details>\n        <summary>每月重置日是按照自然月还是账单日？</summary>\n        <div class=\"faq-answer\">\n          配额重置通常严格依据你的订阅开通日（账单周期）自动循环计算，而不是每个月的 1 号。在用户中心仪表盘可随时核对下一次重置的具体时间戳。\n        </div>\n      </details>\n\n      <details>\n        <summary>遇到订阅列表无法更新应优先排查什么？</summary>\n        <div class=\"faq-answer\">\n          请依次核对本地设备系统时间是否准确（时间偏差过大会导致验证失效）、本地网络是否拦截了托管域名，或在控制面板重置订阅 Token 重新拉取。\n        </div>\n      </details>\n\n      <details>\n        <summary>年付方案与月付方案在服务权益上有何不同？</summary>\n        <div class=\"faq-answer\">\n          年付与月付方案所包含的节点访问池、设备连接数上限及工单支持优先级完全相同，主要区别在于年付享受折算后的周期价格优惠。\n        </div>\n      </details>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <p>© 熊云 服务解析与配置参考。保持专注，理性选择适用方案。</p>\n</footer>",
